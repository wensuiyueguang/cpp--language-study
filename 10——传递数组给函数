#include<iostream>
using namespace std;
double getAverage(int arr[], int size)
{
	int i, sum = 0;
	double avg;
	for (int i = 0; i < size; ++i)
	{
		sum += arr[i];
	}
	avg = double(sum) / size;
	return avg;
}

int main()
{
	int blance[5] = { 1000,2,3,17,50 };
	double avg;
	avg = getAverage(blance, 5);
	cout << "平均值是:" << avg << endl;
	return  0;
}
